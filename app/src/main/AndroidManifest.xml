<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MoemaFit"
        tools:targetApi="31">

        <!-- Tela Splash (Abre primeiro) -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- MainActivity (Login) -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Nova Tela Home Aluno -->
        <activity
            android:name=".HomeAlunoActivity"
            android:exported="false" />

        <!-- Demais telas do projeto (todas com exported="false" por segurança) -->
        <activity android:name=".MenuActivity" android:exported="false" />
        <activity android:name=".ConfiguracoesActivity" android:exported="false" />
        <activity android:name=".RedefinirSenhaActivity" android:exported="false" />
        <activity android:name=".MenuAlunoActivity" android:exported="false" />
        <activity android:name=".DetalhesAulaColetiva" android:exported="false" />
        <activity android:name=".HomeProf" android:exported="false" />
        <activity android:name=".PerfilProfessorActivity" android:exported="false" />
        <activity android:name=".CriarFicha" android:exported="false" />
        <activity android:name=".DetalhesFichaHistoricoActivity" android:exported="false" />
        <activity android:name=".HistoricoFichasProfessorActivity" android:exported="false" />
        <activity android:name=".ListaParticipantesAulaColetiva" android:exported="false" />
        <activity android:name=".PreCadastroAluno" android:exported="false" />
        <activity android:name=".CriarAulaColetivaActivity" android:exported="false" />
        <activity android:name=".DetalhesFeedbackActivity" android:exported="false" />
        <activity android:name=".ListaFeedbacksActivity" android:exported="false" />
        <activity android:name=".BuscarAlunoActivity" android:exported="false" />
        <activity android:name=".PerfilAlunoActivity" android:exported="false" />
        <activity android:name=".FichaAlunoActivity" android:exported="false" />
        <activity android:name=".EditarFichaActivity" android:exported="false" />

        <activity
            android:name=".CalendarioProfessor"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <activity
            android:name=".CalendarioAlunoActivity"
            android:exported="false" />

        <activity android:name=".PontosAlunoActivity" android:exported="false" />

        <activity
            android:name=".ParticiparAulaColetivaActivity"
            android:exported="false" />

        <activity android:name=".ConfiguracoesAlunoActivity" android:exported="false" />

    </application>

</manifest>