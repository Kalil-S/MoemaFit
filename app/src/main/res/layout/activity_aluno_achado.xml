<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/azul_escuro"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/btnVoltar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="Voltar"
        android:padding="16dp"
        android:src="@drawable/ic_arrow_back"
        android:tint="@color/branco" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"
                android:contentDescription="Foto do aluno"
                android:src="@drawable/ic_account_circle"
                android:tint="@color/branco"
                tools:srcCompat="@drawable/ic_person" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divisor" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aluno:"
                    android:textColor="@color/branco" />

                <TextView
                    android:id="@+id/txtNome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Carolina Cavalcante"
                    android:textColor="@color/branco" />

                <TextView
                    android:id="@+id/txtEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Carol@unifor.com"
                    android:textColor="@color/branco" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divisor" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/txtObjetivo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Objetivo: Hipertrofia"
                    android:textColor="@color/branco" />

                <TextView
                    android:id="@+id/txtPeso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Peso: 56 kg"
                    android:textColor="@color/branco" />

                <TextView
                    android:id="@+id/txtValidade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Validade da ficha: 2 meses"
                    android:textColor="@color/branco" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divisor" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Histórico ficha(s)"
                    android:textColor="@color/branco" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ficha"
                        android:tint="@color/branco"
                        tools:srcCompat="?attr/actionModePasteDrawable" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtNomeFicha"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ficha Carolina"
                            android:textColor="@color/branco" />

                        <TextView
                            android:id="@+id/txtDataFicha"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Data: 07/07"
                            android:textColor="@color/branco" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
