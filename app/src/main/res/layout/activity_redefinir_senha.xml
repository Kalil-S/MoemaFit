<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/azul_escuro"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/btnVoltar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/azul_claro"
        android:contentDescription="Voltar"
        android:padding="16dp"
        android:scaleType="fitStart"
        android:src="@drawable/ic_arrow_back" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:text="Redefinir senha"
        android:textColor="@color/branco" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="32dp"
        android:text="Senha atual"
        android:textColor="@color/branco" />

    <EditText
        android:id="@+id/edtSenhaAtual"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="8dp"
        android:autofillHints="password"
        android:background="@color/campo_input"
        android:inputType="textPassword"
        android:paddingHorizontal="12dp"
        android:textColor="@color/branco" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="32dp"
        android:text="Senha nova"
        android:textColor="@color/branco" />

    <EditText
        android:id="@+id/edtSenhaNova"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="8dp"
        android:autofillHints="newPassword"
        android:background="@color/campo_input"
        android:inputType="textPassword"
        android:paddingHorizontal="12dp"
        android:textColor="@color/branco" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSalvar"
        android:layout_width="160dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="48dp"
        android:background="@drawable/bg_botao"
        android:text="Salvar"
        android:textAllCaps="false"
        android:textColor="@color/preto" />
</LinearLayout>
