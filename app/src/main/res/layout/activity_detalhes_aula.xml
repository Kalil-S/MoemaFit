<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/azul_escuro"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnVoltar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="Voltar"
            android:padding="16dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/branco" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detalhes da aula"
            android:textColor="@color/branco"
            android:textSize="20sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Para usar a foto do protótipo: coloque a imagem em res/drawable
                 (ex.: spinning.jpg) e troque por android:src="@drawable/spinning" -->

            <ImageView
                android:id="@+id/imgAula"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:background="@drawable/bg_imagem_aula"
                android:contentDescription="Imagem da aula"
                android:scaleType="centerCrop"
                tools:srcCompat="@drawable/o_que_c3a9_spinning" />

            <TextView
                android:id="@+id/txtNomeAula"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Spinning"
                android:textColor="@color/branco"
                android:textSize="24sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_person"
                android:tint="@color/branco" />

            <TextView
                android:id="@+id/txtProfessor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Prof. Marcio Lima"
                android:textColor="@color/branco"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_calendar"
                android:tint="@color/branco" />

            <TextView
                android:id="@+id/txtData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Sexta, 18 de Setembro"
                android:textColor="@color/branco"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_location"
                android:tint="@color/branco" />

            <TextView
                android:id="@+id/txtSala"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Sala 4"
                android:textColor="@color/branco"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_group"
                android:tint="@color/branco" />

            <TextView
                android:id="@+id/txtVagas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Vagas: 16/ 25"
                android:textColor="@color/branco"
                android:textSize="16sp" />
        </LinearLayout>

            <TextView
                android:id="@+id/txtDescricao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="O spinning foca principalmente na melhoria da aptidão cardiorrespiratória (condicionamento do coração e pulmões) e na tonificação dos membros inferiores (glúteos, quadríceps, coxas e panturrilhas)."
                android:textColor="@color/branco"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnParticipar"
                android:layout_width="160dp"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_botao"
                android:text="Participar"
                android:textAllCaps="false"
                android:textColor="@color/preto" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
