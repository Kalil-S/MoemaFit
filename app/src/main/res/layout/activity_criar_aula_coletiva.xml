<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F1EA"
    android:paddingTop="36dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <!-- TOPO: Logo Unifor e Menu Hambúrguer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/imgLogoUnifor"
            android:layout_width="90dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_unifor_logo"
            android:contentDescription="Logo Unifor" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/imgMenu"
            android:layout_width="80dp"
            android:layout_height="50dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_menu"
            android:contentDescription="Menu" />
    </LinearLayout>

    <!-- CARTÃO CENTRAL DE CADASTRO DE AULA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card_azul"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Título da Tela -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aula Coletiva"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Formulário com Scroll para caber todos os campos confortavelmente -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Nome da aula -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nome da aula"
                    android:textColor="#E0E0E0"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp" />
                <EditText
                    android:id="@+id/editNomeAula"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="#FFFFFF"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:inputType="textPersonName"
                    android:layout_marginBottom="12dp" />

                <!-- E-mail de contato -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="E-mail de contato"
                    android:textColor="#E0E0E0"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp" />
                <EditText
                    android:id="@+id/editEmailContato"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="#FFFFFF"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:inputType="textEmailAddress"
                    android:layout_marginBottom="12dp" />

                <!-- Professor -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Professor"
                    android:textColor="#E0E0E0"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp" />
                <EditText
                    android:id="@+id/editProfessor"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="#FFFFFF"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:inputType="textPersonName"
                    android:layout_marginBottom="12dp" />

                <!-- Data -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Data"
                    android:textColor="#E0E0E0"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp" />
                <EditText
                    android:id="@+id/editData"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="#FFFFFF"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:inputType="date"
                    android:layout_marginBottom="12dp" />

                <!-- Sala -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sala"
                    android:textColor="#E0E0E0"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp" />
                <EditText
                    android:id="@+id/editSala"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="#FFFFFF"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:inputType="text"
                    android:layout_marginBottom="12dp" />

                <!-- Quantidade de pessoas -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quantidade de pessoas"
                    android:textColor="#E0E0E0"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp" />
                <EditText
                    android:id="@+id/editQtdPessoas"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="#FFFFFF"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:inputType="number" />

            </LinearLayout>
        </ScrollView>

        <!-- Botão Salvar -->
        <Button
            android:id="@+id/btnSalvarAula"
            android:layout_width="200dp"
            android:layout_height="48dp"
            android:text="Salvar"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#FFFFFF"
            android:textColor="#0B3B60" />

    </LinearLayout>

</LinearLayout>