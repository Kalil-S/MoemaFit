<?xml version="1.0" encoding="utf-8"?>
<!-- Layout invisível para centralizar o cartão na pré-visualização do Android Studio -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Cartão flutuante de Sucesso -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="28dp"
        app:cardElevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="40dp"
            android:paddingBottom="24dp">

            <!-- Círculo de Destaque com o Ícone (Verde para indicar Sucesso) -->
            <LinearLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/shape_circulo_branco"
                android:backgroundTint="#E6F4EA"
                android:gravity="center">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_send"
                    app:tint="#1E8E3E" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Ficha enviada\ncom sucesso!"
                android:textAlignment="center"
                android:textColor="#333333"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Texto de apoio para enriquecer a experiência do usuário -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:text="O aluno já pode visualizar o novo treino."
                android:textAlignment="center"
                android:textColor="#888888"
                android:textSize="14sp" />

            <!-- Botão OK de largura total -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_dialog_ok"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:backgroundTint="#0A42E4"
                android:text="Ok"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="16dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>