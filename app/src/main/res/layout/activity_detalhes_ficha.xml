                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Série" android:textAlignment="center" android:textColor="#A0A0A0" android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Rep." android:textAlignment="center" android:textColor="#A0A0A0" android:textSize="12sp" android:textStyle="bold" />
