<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#0D1B68"
    android:padding="24dp">

    <!-- Caixa Superior: TREINO CONCLUÍDO -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="40dp"
        app:cardBackgroundColor="#E8F1F5"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:strokeWidth="0dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingVertical="16dp"
            android:text="TREINO CONCLUÍDO"
            android:textColor="#0D1B68"
            android:textSize="18sp"
            android:textStyle="bold" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Ícone / Ilustração Central de Conclusão (Confetes) -->
    <androidx.cardview.widget.CardView
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginBottom="50dp"
        app:cardCornerRadius="80dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#FFFFFF">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="32dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_send"
            app:tint="#0D1B68"
            android:contentDescription="Ícone de parabéns" />
    </androidx.cardview.widget.CardView>

    <!-- Botão Fechar (Retorna para a Home Aluno) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFecharConcluido"
        android:layout_width="220dp"
        android:layout_height="50dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#E8F1F5"
        android:text="Fechar"
        android:textColor="#0D1B68"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="24dp" />

    <!-- Botão Avalie-nos (Vai para FeedbackAlunoActivity) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAvalieNos"
        android:layout_width="220dp"
        android:layout_height="50dp"
        android:backgroundTint="#E8F1F5"
        android:text="Avalie-nos"
        android:textColor="#0D1B68"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="24dp" />

</LinearLayout>