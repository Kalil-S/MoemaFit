<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A42E4"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Substitui "nome_da_tua_imagem" pelo nome exato do ficheiro da imagem que colocaste na pasta drawable -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:src="@drawable/moema_splash"
        android:contentDescription="Tela Splash Moema Fit" />

</LinearLayout>