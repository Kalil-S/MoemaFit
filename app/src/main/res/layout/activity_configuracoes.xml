<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/azul_principal"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/btnVoltar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/azul_claro"
        android:contentDescription="Voltar"
        android:padding="16dp"
        android:scaleType="fitStart"
        android:src="@drawable/ic_arrow_back" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switchFeedbacks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:paddingHorizontal="24dp"
        android:text="Desativar notificação de feedbacks"
        android:textColor="@color/branco" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switchCalendario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="24dp"
        android:text="Desativar notificação do calendário"
        android:textColor="@color/branco" />

    <TextView
        android:id="@+id/txtRedefinirSenha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:text="Redefinir senha"
        android:textColor="@color/branco"
        android:textSize="16sp" />
</LinearLayout>
