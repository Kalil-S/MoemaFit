<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F8FB"
    android:gravity="center_horizontal"
    android:paddingTop="16dp">

    <!-- ============================== -->
    <!-- TOPO: HEADER UNIFOR            -->
    <!-- ============================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/imgLogoUnifor"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/icone_unifor"
            android:scaleType="fitCenter"
            android:contentDescription="Logo Unifor" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unifor"
            android:textColor="#0A42E4"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="10dp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/imgMenu"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:tint="#0A42E4"
            android:contentDescription="Menu" />
    </LinearLayout>

    <!-- ============================== -->
    <!-- CONTEÚDO CENTRAL: LOJA DE PONTOS -->
    <!-- ============================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        android:gravity="center">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardBackgroundColor="#E6E9EE"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center_horizontal">

                <!-- Saldo de Pontos no Topo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="24dp"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/moeda"
                        android:contentDescription="Moeda / Ícone" />

                    <TextView
                        android:id="@+id/txtPontosTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pontos: 0"
                        android:textColor="#000000"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginStart="20dp" />
                </LinearLayout>

                <!-- Item 1: Congelar Streak -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="24dp">

                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@drawable/gelo"
                        app:tint="#000000"
                        android:contentDescription="Floco de Neve" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginStart="16dp">

                        <Button
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:backgroundTint="#0A42E4"
                            android:text="Congelar Streak"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:cornerRadius="20dp" />

                        <Button
                            android:layout_width="90dp"
                            android:layout_height="32dp"
                            android:layout_marginTop="6dp"
                            android:backgroundTint="#0A42E4"
                            android:text="100"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="16dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Item 2: Poção 2x pontos -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="24dp">

                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@drawable/pocao"
                        app:tint="#000000"
                        android:contentDescription="Poção" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginStart="16dp">

                        <Button
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:backgroundTint="#0A42E4"
                            android:text="Poção 2x pontos"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:cornerRadius="20dp" />

                        <Button
                            android:layout_width="90dp"
                            android:layout_height="32dp"
                            android:layout_marginTop="6dp"
                            android:backgroundTint="#0A42E4"
                            android:text="50"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="16dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Item 3: Baú Misterioso -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@drawable/bau"
                        app:tint="#000000"
                        android:contentDescription="Baú" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginStart="16dp">

                        <Button
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:backgroundTint="#0A42E4"
                            android:text="Baú Misterioso"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:cornerRadius="20dp" />

                        <Button
                            android:layout_width="90dp"
                            android:layout_height="32dp"
                            android:layout_marginTop="6dp"
                            android:backgroundTint="#0A42E4"
                            android:text="90"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="16dp" />
                    </LinearLayout>
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Botão Voltar -->
                <Button
                    android:id="@+id/btnVoltar"
                    android:layout_width="150dp"
                    android:layout_height="44dp"
                    android:backgroundTint="#A3B4D3"
                    android:text="Voltar"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

</LinearLayout>